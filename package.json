{
  "name": "re-turbo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "fmt": "oxfmt src index.html package.json tsconfig.json vite.config.ts",
    "fmt:check": "oxfmt --check src index.html package.json tsconfig.json vite.config.ts",
    "check": "tsc --noEmit && oxlint src && oxfmt --check src"
  },
  "devDependencies": {
    "oxfmt": "^0.16.0",
    "oxlint": "^1.28.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
